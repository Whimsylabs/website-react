{
  "name": "whimsylabs-website",
  "homepage": "https://whimsylabs.ai",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "chokidar": "^4.0.3",
    "ejs": "^3.1.10",
    "express": "^4.18.2",
    "front-matter": "^4.0.2",
    "fs-extra": "^11.3.0",
    "glob": "^11.0.3",
    "gray-matter": "^4.0.3",
    "i18next": "^25.3.2",
    "markdown-it": "^14.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^15.6.1",
    "react-scripts": "5.0.1",
    "rimraf": "^6.0.1",
    "web-vitals": "^2.1.4",
    "whimsylabs-website": "file:"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build-spa": "react-scripts build",
    "generate-sitemap": "node generate-sitemap.js",
    "build-static": "npm run build-spa && node build.js && npm run validate-meta-tags && npm run validate-title-length && npm run validate-meta-descriptions && npm run validate-image-alt-text && npm run validate-redirects-metadata && npm run validate-404-redirects && npm run validate-faq-schema && npm run validate-blog-schema && npm run validate-blog-ssr && npm run validate-educational-schema && npm run validate-hreflang && npm run validate-opengraph",
    "build-static-host": "npm run build-static && npx serve build",
    "build-english-only": "npm run build-spa && node scripts/build-english-only.js",
    "clean-build": "node scripts/clean-build.js",
    "generate-blog-data": "node scripts/generate-blog-data.js",
    "generate-faq-translations": "node scripts/generate-faq-translations.js",
    "validate-translations": "npm run validate-faq-translations && npm run validate-blog-translations",
    "validate-faq-translations": "node scripts/validate-faq-translations.js",
    "validate-blog-translations": "node scripts/validate-blog-translations.js",
    "validate-meta-tags": "node scripts/validate-meta-tags.js",
    "validate-title-length": "node scripts/validate-title-length.js",
    "validate-redirects-metadata": "node scripts/validate-redirects-and-metadata.js",
    "validate-404-redirects": "node scripts/validate-404-redirects.js",
    "validate-faq-schema": "node scripts/validate-faq-schema.js",
    "validate-blog-schema": "node scripts/validate-blog-schema.js",
    "validate-educational-schema": "node scripts/validate-educational-schema.js",
    "validate-hreflang": "node scripts/validate-hreflang.js",
    "validate-opengraph": "node scripts/validate-opengraph.js",
    "validate-blog-ssr": "node scripts/validate-blog-ssr.js",
    "validate-internal-links": "node scripts/validate-internal-links.js",
    "validate-meta-descriptions": "node scripts/validate-meta-descriptions.js",
    "validate-image-alt-text": "node scripts/validate-image-alt-text.js",
    "generate-blog-structure": "node scripts/generate-blog-structure.js",
    "apply-faq-translations": "node scripts/apply-faq-translations.js",
    "complete-faq-translations": "node scripts/complete-faq-translations.js",
    "apply-key-translations": "node scripts/apply-key-translations.js",
    "setup-indexnow": "node scripts/setup-indexnow.js",
    "indexnow-submit": "node scripts/indexnow-submit.js",
    "indexnow-test": "node scripts/indexnow-submit.js https://whimsylabs.ai/ https://whimsylabs.ai/blog/",
    "dev": "npm run build-spa && node dev-server.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "predeploy": "npm run build-static",
    "deploy": "gh-pages -d build && powershell -Command \"Write-Host 'Waiting 3 minutes for server to update...'; Start-Sleep -Seconds 180; Write-Host 'Starting IndexNow submission...'\" && npm run indexnow-submit"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/plugin-proposal-class-properties": "^7.18.0",
    "@babel/plugin-proposal-private-methods": "^7.18.0",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "@babel/register": "^7.23.0",
    "babel-plugin-css-modules-transform": "^1.6.2",
    "gh-pages": "^6.3.0",
    "ignore-styles": "^5.0.1"
  }
}
