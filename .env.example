# Example environment variables file
# Copy this file to .env.local and add your actual values

# Form submission endpoint (Google Sheets)
REACT_APP_FORM_SCRIPT_URL=https://script.google.com/macros/s/YOUR_ACTUAL_SCRIPT_ID_HERE/exec

# CRM Webhook URL - for syncing form submissions to WhimsyLabs CRM
# Default: http://localhost:8001/api/webhooks/form (local development)
# Production: Set to your CRM server URL
REACT_APP_CRM_WEBHOOK_URL=http://localhost:8001/api/webhooks/form

# Other configuration values
REACT_APP_CONTACT_EMAIL=hello@whimsylabs.ai
